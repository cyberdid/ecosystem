{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/adoption-plan.schema.json",
  "title": "ProjectAdoptionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec", "status", "planDigest"],
  "properties": {
    "apiVersion": { "const": "adoption.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ProjectAdoptionPlan" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolVersion", "projectName", "configRoot"],
      "properties": {
        "toolVersion": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "configRoot": { "const": ".ai" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "discovery", "operations"],
      "properties": {
        "mode": { "enum": ["fresh", "existing-config", "reinstall"] },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gitAvailable",
            "gitDirty",
            "languageCount",
            "buildFileCount",
            "instructionSurfaceCount",
            "potentialSecretLocationCount"
          ],
          "properties": {
            "gitAvailable": { "type": "boolean" },
            "gitDirty": { "type": ["boolean", "null"] },
            "languageCount": { "type": "integer", "minimum": 0 },
            "buildFileCount": { "type": "integer", "minimum": 0 },
            "instructionSurfaceCount": { "type": "integer", "minimum": 0 },
            "potentialSecretLocationCount": { "type": "integer", "minimum": 0 }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "ownership",
              "beforeState",
              "beforeDigest",
              "afterDigest"
            ],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "action": {
                "enum": [
                  "create-canonical",
                  "create-managed-surface",
                  "append-managed-block",
                  "update-managed-block",
                  "write-lock",
                  "write-state-ignore",
                  "write-adoption-receipt"
                ]
              },
              "ownership": { "enum": ["created", "preexisting", "managed-block", "generated"] },
              "beforeState": { "enum": ["absent", "file", "directory"] },
              "beforeDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
              "afterDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
            },
            "allOf": [
              {
                "if": { "properties": { "action": { "const": "write-adoption-receipt" } } },
                "then": { "properties": { "afterDigest": { "type": "null" } } },
                "else": { "properties": { "afterDigest": { "$ref": "#/$defs/digest" } } }
              },
              {
                "if": { "properties": { "beforeState": { "const": "file" } } },
                "then": { "properties": { "beforeDigest": { "$ref": "#/$defs/digest" } } },
                "else": { "properties": { "beforeDigest": { "type": "null" } } }
              }
            ]
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers", "warnings"],
      "properties": {
        "state": { "enum": ["ready", "clean", "blocked"] },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ECO_[A-Z0-9_]+$" }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ECO_[A-Z0-9_]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } } },
          "then": { "properties": { "blockers": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "clean" } } },
          "then": { "properties": { "blockers": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "blocked" } } },
          "then": { "properties": { "blockers": { "minItems": 1 } } }
        }
      ]
    },
    "planDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*\\\\|.*(?:^|/)\\.\\.(?:/|$))" }
    }
  }
}
