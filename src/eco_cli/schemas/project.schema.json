{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/project.schema.json",
  "title": "ProjectAIConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "project", "references", "policy", "runtime"],
  "properties": {
    "apiVersion": { "const": "ai.ecosystem/v1alpha1" },
    "kind": { "const": "ProjectAIConfig" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owners", "riskProfile"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "riskProfile": { "enum": ["low", "standard", "high", "regulated"] }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "build", "protectedPaths"],
      "properties": {
        "languages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "build": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "test": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "protectedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "capabilities", "deployments", "tools", "trust"],
      "properties": {
        "instructions": { "type": "string", "pattern": "^[^/].*\\.ya?ml$" },
        "capabilities": { "type": "string", "pattern": "^[^/].*\\.ya?ml$" },
        "deployments": { "type": "string", "pattern": "^[^/].*\\.ya?ml$" },
        "tools": { "type": "string", "pattern": "^[^/].*\\.ya?ml$" },
        "trust": { "type": "string", "pattern": "^[^/].*\\.ya?ml$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDecision", "unknownDataClass", "allowDirectEgress"],
      "properties": {
        "defaultDecision": { "const": "deny" },
        "unknownDataClass": { "enum": ["D2", "D3", "D4"] },
        "allowDirectEgress": { "const": false },
        "dataPolicy": { "type": "string" },
        "actionPolicy": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "auditTrail", "sandboxProfile", "telemetry"],
      "properties": {
        "profile": { "enum": ["embedded", "dgx", "team", "enterprise"] },
        "auditTrail": { "enum": ["sqlite", "postgresql", "external"] },
        "sandboxProfile": { "enum": ["inspect", "workspace-change", "build-test", "staging", "production"] },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "includeSensitiveContent"],
          "properties": {
            "enabled": { "type": "boolean" },
            "exporter": { "type": "string" },
            "includeSensitiveContent": { "const": false }
          }
        }
      }
    }
  }
}
