{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/deployments.schema.json",
  "title": "DeploymentCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "deployments", "logicalRoles"],
  "properties": {
    "apiVersion": { "const": "ai.ecosystem/v1alpha1" },
    "kind": { "const": "DeploymentCatalog" },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "adapter", "model", "zone", "allowedDataClasses", "artifactTrust", "declaredCapabilities", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
          "provider": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "endpointRef": { "type": "string", "pattern": "^(?:env:|config:|secret://)" },
          "zone": { "enum": ["Z0", "Z1", "Z2", "Z3", "Z4"] },
          "allowedDataClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["D0", "D1", "D2", "D3"] } },
          "artifactTrust": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "declaredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "observedCapabilitiesRef": { "type": "string" },
          "retention": { "type": "string" },
          "trainingUse": { "enum": ["prohibited", "contractual-opt-out", "unknown"] },
          "region": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "logicalRoles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requiredCapabilities", "allowedDataClasses", "allowedZones", "minimumArtifactTrust", "maximumActionClass", "candidates"],
        "properties": {
          "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "allowedDataClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["D0", "D1", "D2", "D3"] } },
          "allowedZones": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Z0", "Z1", "Z2", "Z3"] } },
          "minimumArtifactTrust": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "maximumActionClass": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
          "candidates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}

