{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/instructions.schema.json",
  "title": "InstructionGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "language", "purpose", "principles", "rules", "conventions", "projections"],
  "properties": {
    "apiVersion": { "const": "ai.ecosystem/v1alpha1" },
    "kind": { "const": "InstructionGraph" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "language": { "type": "string", "minLength": 2 },
    "purpose": { "type": "string", "minLength": 10 },
    "principles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" },
          "text": { "type": "string", "minLength": 5 },
          "priority": { "enum": ["must", "should", "may"] },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseLanguage", "commitStyle"],
      "properties": {
        "responseLanguage": { "type": "string", "minLength": 2 },
        "commitStyle": { "type": "string", "minLength": 3 }
      }
    },
    "projections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "codex": { "$ref": "#/$defs/relativePath" },
        "claude": { "$ref": "#/$defs/relativePath" },
        "copilot": { "$ref": "#/$defs/relativePath" },
        "gemini": { "$ref": "#/$defs/relativePath" },
        "cursor": { "$ref": "#/$defs/relativePath" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    }
  }
}

