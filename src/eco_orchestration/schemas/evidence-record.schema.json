{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/evidence-record/v1alpha1",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "EvidenceRecord" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "planDigest", "sourceBundle", "sourceEntryId", "observation", "provenanceDigest", "trust", "relation", "claimIds"],
      "properties": {
        "planId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "planDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "sourceBundle": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "sourceEntryId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "observation": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
        "provenanceDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "trust": { "enum": ["P0", "P1", "P2"] },
        "relation": { "enum": ["supports", "contradicts", "context"] },
        "claimIds": {
          "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" }
        }
      }
    }
  }
}
