{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/claim-record/v1alpha1",
  "title": "ClaimRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ClaimRecord" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "planDigest", "sourceBundle", "producedByRole", "statement", "classification", "state"],
      "properties": {
        "planId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "planDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "sourceBundle": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "producedByRole": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/roleId" },
        "statement": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
        "classification": { "enum": ["fact", "inference", "recommendation"] },
        "state": { "const": "proposed" }
      }
    }
  }
}
