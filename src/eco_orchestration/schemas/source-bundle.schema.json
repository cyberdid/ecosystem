{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/source-bundle/v1alpha1",
  "title": "SourceBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "SourceBundle" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["ingestionPolicyDigest", "dataClass", "questionEntryId", "totalByteLength", "entries"],
      "properties": {
        "ingestionPolicyDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "dataClass": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/dataClass" },
        "questionEntryId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "totalByteLength": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "artifact", "mediaType", "encoding", "provenance"],
            "properties": {
              "id": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
              "artifact": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
              "mediaType": { "enum": ["application/json", "text/markdown", "text/plain"] },
              "encoding": { "const": "utf-8" },
              "provenance": {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "provenanceDigest", "remoteIdentityDigest", "commitDigest"],
                "properties": {
                  "kind": { "enum": ["local-file", "git", "research-web"] },
                  "provenanceDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
                  "remoteIdentityDigest": {
                    "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" }, { "type": "null" }]
                  },
                  "commitDigest": {
                    "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" }, { "type": "null" }]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
