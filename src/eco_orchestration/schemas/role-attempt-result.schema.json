{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/role-attempt-result/v1alpha1",
  "title": "RoleAttemptResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "RoleAttemptResult" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "planDigest", "roleId", "attempt", "routeDecision", "status", "startedAt", "finishedAt", "output", "errorCode", "usage"],
      "properties": {
        "planId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "planDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "roleId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/roleId" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "routeDecision": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "status": { "enum": ["succeeded", "failed", "denied", "ambiguous"] },
        "startedAt": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/timestamp" },
        "finishedAt": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/timestamp" },
        "output": {
          "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" }, { "type": "null" }]
        },
        "errorCode": {
          "oneOf": [
            { "enum": ["adapter-failed", "budget-exceeded", "cancelled", "malformed-output", "policy-denied", "provider-ambiguous", "provider-mismatch", "timeout"] },
            { "type": "null" }
          ]
        },
        "usage": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/usage" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": { "properties": { "output": { "type": "object" }, "errorCode": { "type": "null" } } },
          "else": { "properties": { "output": { "type": "null" }, "errorCode": { "type": "string" } } }
        }
      ]
    }
  }
}
