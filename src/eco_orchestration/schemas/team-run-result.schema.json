{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/team-run-result/v1alpha1",
  "title": "TeamRunResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "TeamRunResult" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "request", "sourceBundle", "status", "reasonCode", "finalReport", "reviews", "claims", "evidence", "verifications", "routeDecisions", "roleAttempts", "handoffs", "usage", "terminalEvent"],
      "properties": {
        "plan": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "request": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "sourceBundle": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "status": { "enum": ["succeeded", "incomplete", "failed", "denied", "exhausted", "cancelled"] },
        "reasonCode": { "enum": ["accepted", "cancelled", "deadline", "evidence-insufficient", "gate-rejected", "policy-denied", "role-failed", "budget-exhausted", "verification-failed", "revision-exhausted", "no-progress"] },
        "finalReport": {
          "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" }, { "type": "null" }]
        },
        "reviews": { "type": "array", "maxItems": 2, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "claims": { "type": "array", "maxItems": 1000, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "evidence": { "type": "array", "maxItems": 2000, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "verifications": { "type": "array", "maxItems": 1000, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "routeDecisions": { "type": "array", "maxItems": 7, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "roleAttempts": { "type": "array", "maxItems": 7, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "handoffs": { "type": "array", "maxItems": 8, "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" } },
        "usage": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/usage" },
        "terminalEvent": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": {
            "properties": {
              "reasonCode": { "const": "accepted" },
              "finalReport": { "type": "object" },
              "reviews": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
