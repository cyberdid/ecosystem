{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/orchestration-event/v1alpha1",
  "title": "OrchestrationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "OrchestrationEvent" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "planDigest", "sequence", "occurredAt", "eventType", "subject", "previousEventDigest", "reasonCode"],
      "properties": {
        "planId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "planDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "occurredAt": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/timestamp" },
        "eventType": {
          "enum": [
            "run-planned", "route-decided", "role-started", "role-completed", "role-failed",
            "handoff-published", "verification-completed", "review-completed", "run-succeeded",
            "run-incomplete", "run-failed", "run-denied", "run-exhausted", "run-cancelled"
          ]
        },
        "subject": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "previousEventDigest": {
          "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" }, { "type": "null" }]
        },
        "reasonCode": {
          "enum": ["accepted", "budget-exhausted", "cancelled", "completed", "deadline", "evidence-insufficient", "gate-rejected", "planned", "policy-denied", "recorded", "role-failed", "verification-failed", "revision-exhausted", "no-progress"]
        }
      }
    }
  }
}
