{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/role-profile/v1alpha1",
  "title": "RoleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "RoleProfile" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataDefinitionRun" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "instruction", "outputSchema", "inputKinds", "outputKinds", "allowedCapabilities", "allowedDataClasses", "tools", "modelRequirements"],
      "properties": {
        "roleId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/roleId" },
        "instruction": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
        "outputSchema": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
        "inputKinds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "enum": ["source-bundle", "role-handoff", "claim-graph", "synthesis", "review"] }
        },
        "outputKinds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "enum": ["plan", "analysis", "verification", "synthesis", "review"] }
        },
        "allowedCapabilities": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" }
        },
        "allowedDataClasses": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/dataClass" }
        },
        "tools": { "type": "array", "maxItems": 0 },
        "modelRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilityIds", "minimumContextTokens", "maximumDataClass"],
          "properties": {
            "capabilityIds": {
              "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
              "items": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" }
            },
            "minimumContextTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
            "maximumDataClass": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/dataClass" }
          }
        }
      }
    }
  }
}
