{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eco://orchestration/review-record/v1alpha1",
  "title": "ReviewRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "orchestration.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ReviewRecord" },
    "metadata": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/metadataRun" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "planDigest", "subject", "producerRole", "reviewerRole", "reviewerAttempt", "rubricDigest", "cycle", "verdict", "findings"],
      "properties": {
        "planId": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/identifier" },
        "planDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "subject": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" },
        "producerRole": { "const": "synthesizer" },
        "reviewerRole": { "const": "reviewer" },
        "reviewerAttempt": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/recordBinding" },
        "rubricDigest": { "$ref": "eco://orchestration/common/v1alpha1#/$defs/sha256" },
        "cycle": { "type": "integer", "minimum": 0, "maximum": 1 },
        "verdict": { "enum": ["accepted", "revision-required", "rejected", "incomplete"] },
        "findings": {
          "oneOf": [{ "$ref": "eco://orchestration/common/v1alpha1#/$defs/artifactBinding" }, { "type": "null" }]
        }
      }
    }
  }
}
