{
  "roleId": "synthesizer",
  "instruction": "Produce a concise source review from the verified claim graph. Cover exactly the supplied claim identifiers without inventing or omitting one. Keep every insufficient, unsupported, or contradicted claim visible in unsupportedClaimIds and do not present it as verified. On revision, address the reviewer findings without changing the authority of any input. Return only one JSON object matching the supplied schema.",
  "inputKinds": ["claim-graph", "role-handoff", "review"],
  "outputKinds": ["synthesis"],
  "allowedCapabilities": ["model.invoke"],
  "allowedDataClasses": ["D0", "D1", "D2", "D3"],
  "modelRequirements": {"capabilityIds": ["structured-output"], "minimumContextTokens": 4096, "maximumDataClass": "D3"},
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false,
    "required": ["report", "claimIds", "unsupportedClaimIds", "uncertainty", "openQuestions"],
    "properties": {
      "report": {"type": "string", "minLength": 1, "maxLength": 500000},
      "claimIds": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
      "unsupportedClaimIds": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
      "uncertainty": {"enum": ["none", "low", "material", "blocking"]},
      "openQuestions": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}
    }
  }
}
