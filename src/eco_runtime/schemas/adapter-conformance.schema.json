{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/adapter-conformance.schema.json",
  "title": "AdapterConformanceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "AdapterConformanceProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "deploymentId", "testedAt", "validUntil"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "deploymentId": { "$ref": "#/$defs/id" },
        "testedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentIdentityDigest",
        "adapterVersion",
        "suite",
        "status",
        "effectiveCapabilities",
        "probes",
        "deviationCodes"
      ],
      "properties": {
        "deploymentIdentityDigest": { "$ref": "#/$defs/sha256" },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "status": { "enum": ["pass", "fail"] },
        "effectiveCapabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" }
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "attempts", "successes", "evidenceDigest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
              "status": { "enum": ["pass", "fail", "not-run"] },
              "attempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "successes": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "evidenceDigest": { "$ref": "#/$defs/sha256" },
              "metrics": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "latencyP50Ms": { "type": "integer", "minimum": 0 },
                  "latencyP95Ms": { "type": "integer", "minimum": 0 },
                  "inputTokens": { "type": "integer", "minimum": 0 },
                  "outputTokens": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "deviationCodes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ECO_[A-Z0-9_]+$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
