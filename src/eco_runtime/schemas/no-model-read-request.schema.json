{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/no-model-read-request.schema.json",
  "title": "NoModelReadRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "NoModelReadRequest" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "runId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["planDigest", "workflow", "path", "scopeSlot"],
      "properties": {
        "planDigest": { "$ref": "#/$defs/sha256" },
        "workflow": { "const": "wiki-health-check" },
        "path": { "enum": ["wiki/index.md", "wiki/architecture.md", "wiki/roadmap.md"] },
        "scopeSlot": { "enum": ["slot-1", "slot-2", "slot-3"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
