{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/authority/identity-key.schema.json",
  "title": "IdentityKey",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
    "kind": { "const": "IdentityKey" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "purpose", "algorithm", "publicKey", "fingerprint", "status", "validity", "safety"],
      "properties": {
        "subject": { "$ref": "#/$defs/subjectBinding" },
        "purpose": { "enum": ["policy-signing", "approval-signing", "evidence-signing", "workload-authentication"] },
        "algorithm": { "const": "Ed25519" },
        "publicKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "value"],
          "properties": {
            "encoding": { "const": "raw-base64url" },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "status": { "enum": ["active", "retired", "revoked"] },
        "validity": { "$ref": "#/$defs/validity" },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privateKeyPresent", "permissionsGranted", "runtimeAuthorityCreated"],
          "properties": {
            "privateKeyPresent": { "const": false },
            "permissionsGranted": { "const": false },
            "runtimeAuthorityCreated": { "const": false }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "createdAt", "recordDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "createdAt": { "type": "string", "format": "date-time" },
        "recordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "subjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": { "enum": ["TeamIdentity", "PrincipalIdentity"] },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
