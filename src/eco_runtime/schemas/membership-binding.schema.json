{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/authority/membership-binding.schema.json",
  "title": "MembershipBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
    "kind": { "const": "MembershipBinding" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "principal", "status", "validity", "safety"],
      "properties": {
        "team": { "$ref": "#/$defs/teamBinding" },
        "principal": { "$ref": "#/$defs/principalBinding" },
        "status": { "enum": ["active", "suspended", "revoked"] },
        "validity": { "$ref": "#/$defs/validity" },
        "safety": { "$ref": "#/$defs/safety" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "createdAt", "recordDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "createdAt": { "type": "string", "format": "date-time" },
        "recordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "teamBinding": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "properties": { "kind": { "const": "TeamIdentity" } }, "required": ["kind"] }
      ]
    },
    "principalBinding": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "properties": { "kind": { "const": "PrincipalIdentity" } }, "required": ["kind"] }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionsGranted", "runtimeAuthorityCreated"],
      "properties": {
        "permissionsGranted": { "const": false },
        "runtimeAuthorityCreated": { "const": false }
      }
    }
  }
}
