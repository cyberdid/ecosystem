{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/no-model-run-request.schema.json",
  "title": "NoModelRunRequest",
  "description": "Versioned request for the fixed no-model A1 wiki-health-check workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "NoModelRunRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "actor"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["human", "automation"] },
            "id": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "workflow"],
      "properties": {
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "workflow": { "const": "wiki-health-check" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
