{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/repository-read-receipt.schema.json",
  "title": "RepositoryReadReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "RepositoryReadReceipt" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "operationId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "operationId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentDigest", "toolRequestDigest", "repositorySnapshotDigest", "contentDigest", "byteLength", "dataClass", "trust"],
      "properties": {
        "intentDigest": { "$ref": "#/$defs/sha256" },
        "toolRequestDigest": { "$ref": "#/$defs/sha256" },
        "repositorySnapshotDigest": { "$ref": "#/$defs/sha256" },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "dataClass": { "enum": ["D0", "D1", "D2", "D3"] },
        "trust": { "enum": ["P1", "P2", "P3", "P4"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
