{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "PolicyDecision" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "effect", "reasonCodes", "policySnapshot", "constraints"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "digest"],
          "properties": {
            "kind": { "enum": ["RunRequest", "RunPlan", "ToolRequest", "ModelRequest"] },
            "id": { "$ref": "#/$defs/id" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "effect": { "enum": ["allow", "deny"] },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ECO_[A-Z0-9_]+$" }
        },
        "policySnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiVersion",
            "semanticConfigDigest",
            "digestProfile",
            "contractProfile",
            "schemaBundleDigest",
            "policyEngineVersion"
          ],
          "properties": {
            "apiVersion": { "const": "ai.ecosystem/v1alpha1" },
            "semanticConfigDigest": { "$ref": "#/$defs/sha256" },
            "digestProfile": { "const": "eco-python-json-v1" },
            "contractProfile": { "const": "runtime-contracts-v1alpha1" },
            "schemaBundleDigest": { "$ref": "#/$defs/sha256" },
            "policyEngineVersion": { "type": "string", "minLength": 1 }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["singleUse", "expiresAt"],
          "properties": {
            "singleUse": { "const": true },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
