{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/authority/team-key-rotation.schema.json",
  "title": "TeamKeyRotationEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "rotationId",
    "teamId",
    "projectIds",
    "oldAnchor",
    "newAnchor",
    "nonce",
    "issuedAt",
    "signatures"
  ],
  "properties": {
    "protocol": { "type": "string", "minLength": 1, "maxLength": 64 },
    "rotationId": {
      "type": "string",
      "pattern": "^rotation:[a-f0-9]{64}$"
    },
    "teamId": { "$ref": "#/$defs/id" },
    "projectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "oldAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorDigest", "keyId"],
      "properties": {
        "anchorDigest": { "$ref": "#/$defs/sha256" },
        "keyId": { "$ref": "#/$defs/ed25519KeyId" }
      }
    },
    "newAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorDigest", "keyId", "publicKey", "validity"],
      "properties": {
        "anchorDigest": { "$ref": "#/$defs/sha256" },
        "keyId": { "$ref": "#/$defs/ed25519KeyId" },
        "publicKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "encoding", "value"],
          "properties": {
            "algorithm": { "type": "string", "minLength": 1, "maxLength": 32 },
            "encoding": { "type": "string", "minLength": 1, "maxLength": 32 },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "validity": { "$ref": "#/$defs/validity" }
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old", "new"],
      "properties": {
        "old": { "$ref": "#/$defs/signature" },
        "new": { "$ref": "#/$defs/signature" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ed25519KeyId": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]{64}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 32 },
        "keyId": { "$ref": "#/$defs/ed25519KeyId" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
