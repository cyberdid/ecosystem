{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/tool-request.schema.json",
  "title": "ToolRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ToolRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "enum": ["model", "runtime"] }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest", "toolId", "arguments"],
      "properties": {
        "planDigest": { "$ref": "#/$defs/sha256" },
        "toolId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
        "arguments": { "type": "object", "maxProperties": 64 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
