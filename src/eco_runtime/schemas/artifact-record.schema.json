{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/artifact-record.schema.json",
  "title": "ArtifactRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ArtifactRecord" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "mediaType",
        "byteLength",
        "sha256",
        "dataClass",
        "trust",
        "producer",
        "storageRef",
        "retention"
      ],
      "properties": {
        "role": { "enum": ["input", "output", "evidence"] },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "dataClass": { "enum": ["D0", "D1", "D2", "D3", "D4"] },
        "trust": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["operator", "model", "tool", "runtime"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        "parentRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "storageRef": { "$ref": "#/$defs/artifactRef" },
        "retention": { "enum": ["ephemeral", "run", "project-policy"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "string",
      "pattern": "^artifact://(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*%2[fF]|.*%5[cC])[A-Za-z0-9][A-Za-z0-9._:/-]{0,4095}$"
    }
  }
}
