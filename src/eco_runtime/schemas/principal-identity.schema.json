{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/authority/principal-identity.schema.json",
  "title": "PrincipalIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
    "kind": { "const": "PrincipalIdentity" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "validity", "controller", "safety"],
      "properties": {
        "type": { "enum": ["human", "service", "agent", "ci"] },
        "status": { "enum": ["active", "suspended", "revoked"] },
        "validity": { "$ref": "#/$defs/validity" },
        "controller": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identityBinding" }
          ]
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permissionsGranted", "runtimeAuthorityCreated"],
          "properties": {
            "permissionsGranted": { "const": false },
            "runtimeAuthorityCreated": { "const": false }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "createdAt", "recordDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "createdAt": { "type": "string", "format": "date-time" },
        "recordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": { "enum": ["TeamIdentity", "PrincipalIdentity"] },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
