{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/authority/team-approval.schema.json",
  "title": "TeamApprovalRecord",
  "oneOf": [
    { "$ref": "#/$defs/approvalProfile" },
    { "$ref": "#/$defs/approvalRequest" },
    { "$ref": "#/$defs/approvalVote" },
    { "$ref": "#/$defs/actionPermit" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "recordDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "recordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "recordBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {
          "enum": [
            "ApprovalProfile",
            "TeamApprovalRequest",
            "TeamApprovalVote",
            "TeamActionPermit"
          ]
        },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "teamBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest", "revocationEpoch"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "digest": { "$ref": "#/$defs/sha256" },
        "revocationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": { "$ref": "#/$defs/timestamp" },
        "notAfter": { "$ref": "#/$defs/timestamp" }
      }
    },
    "actionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "actionClass", "operation", "digest"],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "actionClass": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{1,63}$"
        },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{1,63}$"
        },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "principalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "membershipDigest"],
      "properties": {
        "principalId": { "$ref": "#/$defs/id" },
        "membershipDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "approverBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "keyId", "membershipDigest"],
      "properties": {
        "principalId": { "$ref": "#/$defs/id" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "membershipDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "approvalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
        "kind": { "const": "ApprovalProfile" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "team",
            "policy",
            "requiredApproverRole",
            "quorum",
            "validity",
            "safety"
          ],
          "properties": {
            "purpose": { "enum": ["runtime-action", "emergency-recovery"] },
            "team": { "$ref": "#/$defs/teamBinding" },
            "policy": { "$ref": "#/$defs/policyBinding" },
            "requiredApproverRole": { "$ref": "#/$defs/role" },
            "quorum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "validity": { "$ref": "#/$defs/validity" },
            "safety": {
              "type": "object",
              "additionalProperties": false,
              "required": ["permissionsGranted", "runtimeAuthorityCreated"],
              "properties": {
                "permissionsGranted": { "const": false },
                "runtimeAuthorityCreated": { "const": false }
              }
            }
          }
        }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
        "kind": { "const": "TeamApprovalRequest" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "requester",
            "action",
            "resource",
            "snapshot",
            "policy",
            "expiresAt",
            "safety"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/recordBinding" },
            "requester": { "$ref": "#/$defs/principalBinding" },
            "action": { "$ref": "#/$defs/actionBinding" },
            "resource": { "$ref": "#/$defs/resourceBinding" },
            "snapshot": { "$ref": "#/$defs/snapshotBinding" },
            "policy": { "$ref": "#/$defs/policyBinding" },
            "expiresAt": { "$ref": "#/$defs/timestamp" },
            "safety": {
              "type": "object",
              "additionalProperties": false,
              "required": ["humanApprovalRequired", "permissionsGranted"],
              "properties": {
                "humanApprovalRequired": { "const": true },
                "permissionsGranted": { "const": false }
              }
            }
          }
        }
      }
    },
    "approvalVote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
        "kind": { "const": "TeamApprovalVote" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "request",
            "approver",
            "decision",
            "issuedAt",
            "expiresAt",
            "signature"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/recordBinding" },
            "request": { "$ref": "#/$defs/recordBinding" },
            "approver": { "$ref": "#/$defs/approverBinding" },
            "decision": { "enum": ["approve", "deny"] },
            "issuedAt": { "$ref": "#/$defs/timestamp" },
            "expiresAt": { "$ref": "#/$defs/timestamp" },
            "signature": { "$ref": "#/$defs/signature" }
          }
        }
      }
    },
    "permitApprover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "keyId", "membershipDigest", "vote"],
      "properties": {
        "principalId": { "$ref": "#/$defs/id" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "membershipDigest": { "$ref": "#/$defs/sha256" },
        "vote": { "$ref": "#/$defs/recordBinding" }
      }
    },
    "actionPermit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "authority.ai.ecosystem/v1alpha1" },
        "kind": { "const": "TeamActionPermit" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "request",
            "action",
            "resource",
            "snapshot",
            "policy",
            "approvers",
            "quorum",
            "issuedAt",
            "expiresAt",
            "constraints",
            "safety"
          ],
          "properties": {
            "profile": { "$ref": "#/$defs/recordBinding" },
            "request": { "$ref": "#/$defs/recordBinding" },
            "action": { "$ref": "#/$defs/actionBinding" },
            "resource": { "$ref": "#/$defs/resourceBinding" },
            "snapshot": { "$ref": "#/$defs/snapshotBinding" },
            "policy": { "$ref": "#/$defs/policyBinding" },
            "approvers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/permitApprover" }
            },
            "quorum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "issuedAt": { "$ref": "#/$defs/timestamp" },
            "expiresAt": { "$ref": "#/$defs/timestamp" },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "required": ["singleUse", "consumptionNonceDigest"],
              "properties": {
                "singleUse": { "const": true },
                "consumptionNonceDigest": { "$ref": "#/$defs/sha256" }
              }
            },
            "safety": {
              "type": "object",
              "additionalProperties": false,
              "required": ["storeIntegrationRequired", "runtimeAuthorityCreated"],
              "properties": {
                "storeIntegrationRequired": { "const": true },
                "runtimeAuthorityCreated": { "const": false }
              }
            }
          }
        }
      }
    }
  }
}
