{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/model-request.schema.json",
  "title": "ModelRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ModelRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest", "deploymentId", "deploymentIdentityDigest", "endpointBindingDigest", "input", "parameters", "timeoutMs", "fallbackPolicy"],
      "properties": {
        "planDigest": { "$ref": "#/$defs/sha256" },
        "deploymentId": { "$ref": "#/$defs/id" },
        "deploymentIdentityDigest": { "$ref": "#/$defs/sha256" },
        "endpointBindingDigest": { "$ref": "#/$defs/sha256" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactRecordDigest", "contentDigest", "byteLength", "dataClass", "trust"],
          "properties": {
            "artifactRecordDigest": { "$ref": "#/$defs/sha256" },
            "contentDigest": { "$ref": "#/$defs/sha256" },
            "byteLength": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
            "dataClass": { "enum": ["D0", "D1", "D2", "D3"] },
            "trust": { "enum": ["P0", "P1", "P2", "P3", "P4"] }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxOutputTokens", "maxOutputBytes", "temperatureMillis"],
          "properties": {
            "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
            "temperatureMillis": { "type": "integer", "minimum": 0, "maximum": 2000 }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "fallbackPolicy": { "const": "none" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
