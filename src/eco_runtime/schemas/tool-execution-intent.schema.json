{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/runtime/tool-execution-intent.schema.json",
  "title": "ToolExecutionIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.ai.ecosystem/v1alpha1" },
    "kind": { "const": "ToolExecutionIntent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKeyDigest", "planDigest", "toolRequest", "allowDecision", "toolCatalogDigest", "reservation", "repositoryEntry"],
      "properties": {
        "idempotencyKeyDigest": { "$ref": "#/$defs/sha256" },
        "planDigest": { "$ref": "#/$defs/sha256" },
        "toolRequest": { "$ref": "#/$defs/recordBinding" },
        "allowDecision": { "$ref": "#/$defs/recordBinding" },
        "toolCatalogDigest": { "$ref": "#/$defs/sha256" },
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolRequests", "inputBytes"],
          "properties": {
            "toolRequests": { "const": 1 },
            "inputBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
          }
        },
        "repositoryEntry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotDigest", "pathDigest", "contentDigest", "byteLength", "dataClass", "trust"],
          "properties": {
            "snapshotDigest": { "$ref": "#/$defs/sha256" },
            "pathDigest": { "$ref": "#/$defs/sha256" },
            "contentDigest": { "$ref": "#/$defs/sha256" },
            "byteLength": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
            "dataClass": { "enum": ["D0", "D1", "D2", "D3"] },
            "trust": { "enum": ["P1", "P2", "P3", "P4"] }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
