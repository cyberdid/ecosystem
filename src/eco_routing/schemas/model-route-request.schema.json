{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.ecosystem.local/schemas/routing/model-route-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "routing.ai.ecosystem/v1alpha1"},
    "kind": {"const": "ModelRouteRequest"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "actionClass", "dataClass", "workloadClass", "requiredCapabilities", "requiredContextTokens", "inputTokenCeiling", "outputTokenCeiling", "allowedZones", "allowedRetentions", "allowCloud", "maximumCostMicrousd", "deadlineAt", "executionProfile", "policyDigest", "contextDigest"],
      "properties": {
        "role": {"$ref": "common.schema.json#/$defs/role"},
        "actionClass": {"$ref": "common.schema.json#/$defs/actionClass"},
        "dataClass": {"$ref": "common.schema.json#/$defs/dataClass"},
        "workloadClass": {"enum": ["interactive", "batch", "review", "research", "coding"]},
        "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/capability"}},
        "requiredContextTokens": {"type": "integer", "minimum": 1},
        "inputTokenCeiling": {"type": "integer", "minimum": 0},
        "outputTokenCeiling": {"type": "integer", "minimum": 1},
        "allowedZones": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/zone"}},
        "allowedRetentions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/retention"}},
        "allowCloud": {"type": "boolean"},
        "maximumCostMicrousd": {"type": "integer", "minimum": 0},
        "deadlineAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "executionProfile": {"enum": ["m6.1-local-zero-cost", "standard"]},
        "policyDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "contextDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "executionPlanDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "aggregateBudget": {
          "type": "object", "additionalProperties": false,
          "required": ["maximumCalls", "inputTokenCeiling", "outputTokenCeiling", "maximumCostMicrousd"],
          "properties": {
            "maximumCalls": {"type": "integer", "minimum": 1, "maximum": 10000},
            "inputTokenCeiling": {"type": "integer", "minimum": 0},
            "outputTokenCeiling": {"type": "integer", "minimum": 1},
            "maximumCostMicrousd": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
