{
  "apiVersion": "ai.ecosystem/v1alpha1",
  "kind": "MCPAdapterInventory",
  "notice": "Discovery inventory only. Canonical authorization and capability bindings live in .ai/tools.yaml. No server is trusted by self-description.",
  "servers": [
    {
      "id": "filesystem",
      "purpose": "Local repository access",
      "scope": "per-machine",
      "trust": "P0",
      "enabled": false
    },
    {
      "id": "github",
      "purpose": "GitHub API through a broker-owned credential reference",
      "scope": "project",
      "trust": "P0",
      "enabled": false
    },
    {
      "id": "postgres-spark",
      "purpose": "DGX lab PostgreSQL access",
      "scope": "dgx-lab",
      "trust": "P0",
      "enabled": false
    },
    {
      "id": "spark-ts",
      "purpose": "Custom DGX lab capabilities",
      "scope": "dgx-lab",
      "trust": "P0",
      "enabled": false
    }
  ]
}
