# Authenticated evidence must retain its exact published bytes across platforms.
.ai/evals/live/** -text -diff

# Archived source material is retained byte-for-byte as reviewed.
docs/research/sources/** -text -diff

# Deterministic client projections must retain compiler-emitted LF bytes.
/.ai/*.yaml text eol=lf
/AGENTS.md text eol=lf
/CLAUDE.md text eol=lf
/GEMINI.md text eol=lf
/.github/copilot-instructions.md text eol=lf
/.cursor/rules/eco.mdc text eol=lf

# Digest-pinned package-owned sources: their SHA-256 must be stable across
# platforms, so their exact bytes (LF) must survive a Windows checkout.
src/eco_skills/catalog/** text eol=lf
src/eco_cli/schemas/** text eol=lf
src/eco_runtime/schemas/** text eol=lf
